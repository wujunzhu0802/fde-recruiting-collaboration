MVP_DB=runtime/mvp/data.sqlite
MVP_ADMIN_EMAIL=admin@recruiting.local
# Supply a unique secret before first startup; otherwise generated in runtime only.
MVP_ADMIN_PASSWORD=
MVP_SECURE_COOKIES=0
# Optional HTTPS OpenAI-compatible provider. Empty key => clearly labeled extractive mode.
MVP_LLM_BASE_URL=https://api.openai.com/v1
MVP_LLM_MODEL=gpt-4.1-mini
MVP_LLM_API_KEY=
